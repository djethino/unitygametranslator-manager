<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    One palette for three products.

    The website, the mod and this installer are pieces of the same thing, and a family that does
    not look like a family reads as three unrelated tools. Nothing here is invented.

    Surfaces, borders and text are the WEBSITE's, which is the reference: its own recurring
    card is `bg-gray-800 rounded-lg p-6 border border-gray-700` and its inputs are
    `bg-gray-800/80 border-gray-600/50 rounded-lg focus:border-purple-500`. Those two patterns
    are reproduced literally below, so a player moving between the site and this window is
    looking at the same thing.

    (An earlier revision took the surfaces from the mod's E0–E4 elevation scale. Same family,
    a touch bluer — but the mod's values are tuned to stay readable ON TOP OF a running game,
    a constraint neither the site nor this tool has. The site is the closer reference here.)

    The accent is the site's purple, which is also the pairing in its icon, so the app icon and
    the interface agree. Status colours are shared by the site and the mod already.
  -->

  <!-- Surfaces — Tailwind grays, as used by the site -->
  <SolidColorBrush x:Key="SurfaceBase" Color="#111827" />      <!-- gray-900, page body -->
  <SolidColorBrush x:Key="SurfaceBar" Color="#1A2332" />       <!-- header and status bar -->
  <SolidColorBrush x:Key="SurfaceCard" Color="#1F2937" />      <!-- gray-800, the site's card -->
  <SolidColorBrush x:Key="SurfaceCardHover" Color="#273449" />
  <SolidColorBrush x:Key="SurfaceInput" Color="#1B2431" />     <!-- gray-800/80, form field recessed in a card -->
  <SolidColorBrush x:Key="SurfaceControl" Color="#374151" />   <!-- gray-700, the site's search field -->

  <SolidColorBrush x:Key="BorderSubtle" Color="#374151" />     <!-- gray-700, the card's edge -->
  <SolidColorBrush x:Key="BorderStrong" Color="#4B5563" />     <!-- gray-600, the input's edge -->

  <!-- Text — the site's gray ramp -->
  <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6" />      <!-- gray-100 -->
  <SolidColorBrush x:Key="TextSecondary" Color="#D1D5DB" />    <!-- gray-300 -->
  <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF" />        <!-- gray-400 -->

  <!-- Accent: the site's purple -->
  <SolidColorBrush x:Key="Accent" Color="#A855F7" />           <!-- purple-500 -->
  <SolidColorBrush x:Key="AccentDeep" Color="#7C3AED" />       <!-- violet-600 -->
  <SolidColorBrush x:Key="AccentSoft" Color="#C084FC" />       <!-- purple-400 -->
  <SolidColorBrush x:Key="AccentSelected" Color="#2E2547" />   <!-- selected row, purple over the card -->

  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#7C3AED" Offset="0" />
    <GradientStop Color="#A855F7" Offset="1" />
  </LinearGradientBrush>

  <!-- Status, shared with the mod and the site -->
  <SolidColorBrush x:Key="StatusSuccess" Color="#4ADE80" />    <!-- green-400 -->
  <SolidColorBrush x:Key="StatusWarning" Color="#FBBF24" />    <!-- amber-400 -->
  <SolidColorBrush x:Key="StatusError" Color="#F87171" />      <!-- red-400 -->
  <SolidColorBrush x:Key="StatusInfo" Color="#60A5FA" />       <!-- blue-400 -->
  <SolidColorBrush x:Key="StatusNeutral" Color="#6B7280" />    <!-- gray-500 -->

  <!-- Callouts: the hue laid over the surface, never a flat saturated block -->
  <SolidColorBrush x:Key="CalloutErrorBg" Color="#2C1B20" />
  <SolidColorBrush x:Key="CalloutWarningBg" Color="#2B2419" />
  <SolidColorBrush x:Key="CalloutInfoBg" Color="#1A2333" />

  <!-- Shape — rounded-lg is the site's radius on cards, inputs and buttons alike -->
  <CornerRadius x:Key="RadiusCard">8</CornerRadius>
  <CornerRadius x:Key="RadiusControl">8</CornerRadius>

</ResourceDictionary>
