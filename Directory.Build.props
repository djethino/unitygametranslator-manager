<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>

    <!-- Where the catalogs are fetched from, in this order. A folder, not a file: every
         catalog we add (loaders, models) sits beside the others and needs no new setting.
         GitHub first on purpose: fetching them from our own site would put an IP in our
         server logs on every launch, and we have no reason to hold that. -->
    <CatalogPrimaryBase>https://raw.githubusercontent.com/djethino/unitygametranslator-installer/main/catalog</CatalogPrimaryBase>
    <CatalogMirrorBase>https://unitygametranslator.asymptomatikgames.com/catalog</CatalogMirrorBase>

    <!-- UnityGameTranslator services (same values as the mod's Directory.Build.props) -->
    <ApiBaseUrl>https://unitygametranslator.asymptomatikgames.com/api/v1</ApiBaseUrl>
    <WebsiteBaseUrl>https://unitygametranslator.asymptomatikgames.com</WebsiteBaseUrl>

    <!-- The event streams, served by a micro-server of their own rather than by the site. Same
         value as the mod's Directory.Build.props: they read the same stream, so a difference here
         would mean one of the two signing in against a server the other never sees. -->
    <SseBaseUrl>https://sse-unitygametranslator.asymptomatikgames.com</SseBaseUrl>

    <!-- Where mod releases are published -->
    <ModReleasesApi>https://api.github.com/repos/djethino/unitygametranslator/releases</ModReleasesApi>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Symbols inside each assembly rather than beside it, for every project rather than only the
      one that produces the executable. Set on the GUI alone, it left the Core project's .pdb next
      to the published file — so "one file" was true of the build and false of the folder someone
      actually unzips.
    -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Generate BuildInfo.g.cs so URLs and version live in exactly one place -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildInfoContent>
namespace UnityGameTranslator.Installer {
    internal static class BuildInfo {
        public const string Version = "$(Version)"%3B
        public const string CatalogPrimaryBase = "$(CatalogPrimaryBase)"%3B
        public const string CatalogMirrorBase = "$(CatalogMirrorBase)"%3B
        public const string ApiBaseUrl = "$(ApiBaseUrl)"%3B
        public const string WebsiteBaseUrl = "$(WebsiteBaseUrl)"%3B
        public const string SseBaseUrl = "$(SseBaseUrl)"%3B
        public const string ModReleasesApi = "$(ModReleasesApi)"%3B
    }
}
      </BuildInfoContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs"
                      Lines="$(BuildInfoContent)"
                      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
  </Target>
</Project>
