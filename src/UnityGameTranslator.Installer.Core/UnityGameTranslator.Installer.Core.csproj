<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable and ImplicitUsings come from Directory.Build.props so every
       project in the solution moves together. -->
  <PropertyGroup>
    <RootNamespace>UnityGameTranslator.Installer.Core</RootNamespace>
    <AssemblyName>UnityGameTranslator.Installer.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The catalog ships inside the binary so the tool still works offline, or behind a
         network that blocks GitHub. It is the last-resort source, never the first. -->
    <EmbeddedResource Include="..\..\catalog\loaders.json"
                      LogicalName="UnityGameTranslator.Installer.Core.Resources.loaders.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Registry access for Steam and GOG discovery. Windows-only at runtime; the calls sit
         behind SupportedOSPlatform so a Linux build never reaches them. -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

</Project>
