<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UnityGameTranslator.Installer.Gui.MainWindow"
        Title="UnityGameTranslator Installer"
        Width="1040" Height="680"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="avares://UnityGameTranslatorInstaller/Assets/app.ico"
        Background="{DynamicResource SurfaceBase}">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header -->
    <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource SurfaceBar}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
          <Image Source="avares://UnityGameTranslatorInstaller/Assets/icon-128.png"
                 Width="34" Height="34" VerticalAlignment="Center" />
          <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Your Unity games" FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" />
          <TextBlock x:Name="SubtitleText" FontSize="12"
                     Text="Scanning..." Foreground="{DynamicResource TextMuted}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBox x:Name="SearchBox" Width="230" Watermark="Search your games" />
          <Button x:Name="AddFolderButton" Content="Add a folder..." />
          <Button x:Name="FoldersButton" Content="My folders" />
          <Button x:Name="RescanButton" Content="Rescan" />
          <Button x:Name="AboutButton" Content="About" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body: games on the left, the selected game on the right -->
    <Grid Grid.Row="1" ColumnDefinitions="370,*">

      <ListBox Grid.Column="0" x:Name="GameList" Classes="cards"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

      <ScrollViewer Grid.Column="1">
        <StackPanel x:Name="DetailPanel" Margin="20,16,24,24" Spacing="14">
          <TextBlock Text="Select a game on the left." Foreground="{DynamicResource TextMuted}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Padding="16,8" Background="{DynamicResource SurfaceBar}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                   FontSize="12" Text="Ready." TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextSecondary}" />
        <ProgressBar x:Name="BusyBar" Grid.Column="1" Width="160" Height="4"
                     Foreground="{DynamicResource Accent}"
                     IsIndeterminate="True" IsVisible="False" />
      </Grid>
    </Border>
  </Grid>
</Window>
