<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>

    <!-- Where the catalogs are fetched from, in this order. A folder, not a file: every
         catalog we add (loaders, models, languages) sits beside the others and needs no new
         setting. They live in their own repository now — a catalogue kept inside one of its
         consumers makes that consumer the owner of a fact the others also depend on.
         GitHub first on purpose: fetching them from our own site would put an IP in our
         server logs on every launch, and we have no reason to hold that. -->
    <CatalogPrimaryBase>https://raw.githubusercontent.com/djethino/unitygametranslator-catalogs/main</CatalogPrimaryBase>
    <CatalogMirrorBase>https://unitygametranslator.asymptomatikgames.com/catalog</CatalogMirrorBase>

    <!-- UnityGameTranslator services (same values as the mod's Directory.Build.props) -->
    <ApiBaseUrl>https://unitygametranslator.asymptomatikgames.com/api/v1</ApiBaseUrl>
    <WebsiteBaseUrl>https://unitygametranslator.asymptomatikgames.com</WebsiteBaseUrl>

    <!-- The event streams, served by a micro-server of their own rather than by the site. Same
         value as the mod's Directory.Build.props: they read the same stream, so a difference here
         would mean one of the two signing in against a server the other never sees. -->
    <SseBaseUrl>https://sse-unitygametranslator.asymptomatikgames.com</SseBaseUrl>

    <!-- Where mod releases are published -->
    <ModReleasesApi>https://api.github.com/repos/djethino/unitygametranslator/releases</ModReleasesApi>

    <!-- Where this tool's own releases are published. Separate from the mod's on purpose: the two
         are versioned apart, and someone testing a beta of the installer has not thereby agreed to
         put a beta of the mod into their games. -->
    <ToolRepo>djethino/unitygametranslator-manager</ToolRepo>
    <ToolReleasesApi>https://api.github.com/repos/djethino/unitygametranslator-manager/releases</ToolReleasesApi>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Symbols inside each assembly rather than beside it, for every project rather than only the
      one that produces the executable. Set on the GUI alone, it left the Core project's .pdb next
      to the published file — so "one file" was true of the build and false of the folder someone
      actually unzips.
    -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Generate BuildInfo.g.cs so URLs and version live in exactly one place.

       🔴 **BeforeTargets="PrepareForBuild", not "CoreCompile".** CoreCompile is SKIPPED when the
       sources are older than the assembly — so on an up-to-date tree this target never ran, the
       generated file kept whatever the previous build had put in it, and a build asked to point
       somewhere else (-p:ApiBaseUrl=…, as prepare-release.ps1 -LocalSite does) silently produced a
       binary carrying the OLD addresses. It worked whenever something happened to force a
       recompilation, which is the worst kind of failure: intermittent, and invisible in the log.

       PrepareForBuild runs on every build. WriteOnlyWhenDifferent keeps the incremental build:
       the file is rewritten only when its content actually changes, and that change is what makes
       the compiler consider the assembly out of date. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <BuildInfoContent>
namespace UnityGameTranslator.Manager {
    internal static class BuildInfo {
        public const string Version = "$(Version)"%3B
        public const string CatalogPrimaryBase = "$(CatalogPrimaryBase)"%3B
        public const string CatalogMirrorBase = "$(CatalogMirrorBase)"%3B
        public const string ApiBaseUrl = "$(ApiBaseUrl)"%3B
        public const string WebsiteBaseUrl = "$(WebsiteBaseUrl)"%3B
        public const string SseBaseUrl = "$(SseBaseUrl)"%3B
        public const string ModReleasesApi = "$(ModReleasesApi)"%3B
        public const string ToolRepo = "$(ToolRepo)"%3B
        public const string ToolReleasesApi = "$(ToolReleasesApi)"%3B
    }
}
      </BuildInfoContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs"
                      Lines="$(BuildInfoContent)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
  </Target>
</Project>
