<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>UnityGameTranslator.Installer.Gui</RootNamespace>
    <AssemblyName>UnityGameTranslatorInstaller</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Same icon as the website: one identity across the ecosystem -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!--
      ⚠ Compression stays OFF, and this is not a size oversight.

      A compressed bundle is a small stub followed by one large compressed blob it unpacks in
      memory at startup. To a static heuristic that is the definition of a packer, which is what
      malware uses to hide its contents. Measured on a real machine, 2026-08-09: the compressed
      build was quarantined as Gen:Variant.Yogi.44836 the moment it was written, and the publish
      itself failed with fifteen access errors as the file was taken away mid-build. The same
      code with compression off was never touched.

      An antivirus quarantining the installer does not produce a bug report. It produces someone
      who concludes the project is shady and leaves, and we never hear about it. Forty-eight
      megabytes of download is a far cheaper price — and it is paid once, at the download, since
      the release archive is compressed anyway.
    -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!--
      Trimming is off for now: Avalonia resolves a good deal through reflection, and a trimmed
      build that starts fine here can fail on a screen nobody opened before shipping. Worth
      revisiting once the window has actually been walked through end to end.
    -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- DebugType lives in Directory.Build.props: it has to hold for every project, not just
         this one, or the others drop their .pdb beside the published executable. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.10" />

    <!--
      For reading the icon a game keeps in its own executable. Windows-only by nature: the package
      throws on other systems, so every call sits behind a platform guard and Linux simply shows no
      icon. Nothing is downloaded and no other source was viable — see GameIcons.
    -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnityGameTranslator.Installer.Core\UnityGameTranslator.Installer.Core.csproj" />
  </ItemGroup>

</Project>
