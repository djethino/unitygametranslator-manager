<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UnityGameTranslator.Manager.Gui.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://UnityGameTranslatorManager/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!--
      Fluent's defaults are square-ish and blue; the site is rounded and purple. The shared
      controls are restated once here rather than fought property by property in every window.
    -->

    <!--
      THREE REGISTERS, AND THEY ARE TOLD APART BY MATTER RATHER THAN BY SHADE.

        primary     filled purple      the act of the section
        secondary   outlined           possible, and less loud than the one above
        disabled    neither            nothing to press

      ⚠ The rule this replaces was "different greys", and it collided: a disabled primary was
      painted SurfaceControl, which is exactly what a secondary button looked like when it was
      perfectly pressable. The same grey meant "press me" and "you cannot press me" on one screen.
      No amount of tuning two greys fixes that — so availability is now carried by the PRESENCE of
      a fill or an outline, which survives a bad screen, low light and colour blindness, where two
      shades of grey do not.

      ⚠ Nothing is blue. Blue is taken: StatusInfo is what "0.7.3 is available" is written in.
      Painting secondary buttons blue would steal that meaning AND put a second call-to-action
      colour against the purple — two action colours is no hierarchy at all.

      ⚠ Set on the Button, not on its ContentPresenter, so a button that declares its own
      Background in code (the bare glyph buttons) still wins. The states below have to reach the
      presenter, because that is where Fluent paints them.
    -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceCardHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceControl}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!--
      Deliberately NOT called "accent": Fluent already defines a Button.accent class that paints
      the system blue, and it wins. The primary action came out blue because of that collision.
      The colour also has to be set on the template ContentPresenter — setting Background on the
      Button alone loses to the template.
    -->
    <Style Selector="Button.primary">
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentEdge}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentDeep}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <!--
      PLAY, and it is the one exception to "a single action colour".

      Not louder than the purple and not quieter: of another NATURE. Everything else on this
      screen prepares a game; this one ends the preparation. Tonal rather than filled — two solid
      buttons side by side compete for the same glance, and the one-click has to keep winning that
      glance while there is anything left to do.

      The fill is the callout green already used by the notices, so this introduces no colour the
      palette did not have: it is the same green, at the same tint, as "this went well".
    -->
    <Style Selector="Button.play">
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.play /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CalloutSuccessBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccess}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource StatusSuccess}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>
    <Style Selector="Button.play:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CalloutSuccessHoverBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccess}" />
      <Setter Property="Foreground" Value="{DynamicResource StatusSuccess}" />
    </Style>
    <Style Selector="Button.play:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CalloutSuccessHoverBg}" />
      <Setter Property="Foreground" Value="{DynamicResource StatusSuccess}" />
    </Style>

    <!--
      Fields. The site makes a distinction worth keeping: a SEARCH field is a lighter grey,
      because it sits ON a surface and has to read as something you act on, while a FORM field
      inside a card is darker, recessed into the card it belongs to. The default here is the
      search shade, since that is what this window has; a card field carries Classes="recessed".

      Fluent paints TextBox through named theme resources, NOT through the control Background:
      overriding the template border was silently ignored and the field stayed near-black
      (#10151E against the site's #3C4758). These are the knobs that actually work.
    -->
    <!--
      Fields and pickers. Fluent paints them through named theme resources of its own, NOT through
      the control Background — those live in ThemeResources.ApplyFluentOverrides now, posted
      application-wide from the shared palette.

      ⚠ They used to be `Style.Resources` blocks right here, and that was already known to be a
      trap: Style.Resources is not scoped to the controls its selector matches, the resources are
      poured into the surrounding scope. A `TextBox.recessed` block once quietly restyled every
      field in the window. Application-wide is what was happening anyway; now it is declared as
      such, in one place, from one palette.

      The site's distinction is kept there: a form field inside a card is recessed and darker, a
      search field sits on a surface and is lighter.
    -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Padding" Value="12,7" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
      <Setter Property="Padding" Value="12,6" />
    </Style>

    <!--
      Filter chips.

      Their own class rather than the primary button's: selection must not change how much room
      a chip takes. Reusing "primary" made the selected one wider and heavier, so the wrap panel
      reflowed between two and three lines depending on which filter was active — the row moved
      under the pointer that had just clicked it. Only colours change here; padding, font size
      and weight are identical in both states.
    -->
    <Style Selector="Button.filter">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>
    <Style Selector="Button.filter /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>
    <Style Selector="Button.filter:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceCardHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.filter.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSelected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentEdge}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.filter.selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSelected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSoft}" />
    </Style>

    <!--
      The game list: real cards, like the site's.

      Each row carries the site's recipe (gray-800 fill, gray-700 edge, 8px radius) with a gap
      between them, so the list reads as a stack of objects rather than as a table. Selection is
      an accent edge over a purple-tinted fill, not a solid block: a row has to stay readable
      once it is selected.
    -->
    <Style Selector="ListBox.cards">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="ListBox.cards > ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
    </Style>
    <Style Selector="ListBox.cards > ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
    </Style>
    <Style Selector="ListBox.cards > ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceCardHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>
    <Style Selector="ListBox.cards > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSelected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentEdge}" />
    </Style>
    <Style Selector="ListBox.cards > ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSelected}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSoft}" />
    </Style>
    <!--
      DISABLED, FOR EVERY BUTTON, AND DECLARED LAST ON PURPOSE.

      At comparable specificity Avalonia applies the last matching style, so this is what keeps a
      class — primary, play, filter — from dressing up a button nobody can press.

      ⚠ BorderThickness stays 1. Dropping it to 0 would resize the button as it becomes available
      again, moving whatever sits beside it under the pointer.

      ⚠ AND THE BRUSH STAYS VISIBLE. It used to be transparent, which was survivable while a button
      was a word: the word alone still read as a button. It stopped being survivable when buttons
      started carrying the scope marks before their label — with no outline, the icons float beside
      the text belonging to nothing, and the whole thing reads as debris rather than as one control
      that cannot be pressed. A quiet edge says "this is a control"; the muted text and the opacity
      say "not now". Those are two different statements and both are needed.
    -->
    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </Application.Styles>
</Application>
