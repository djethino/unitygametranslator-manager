<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UnityGameTranslator.Installer.Gui.MainWindow"
        Title="UnityGameTranslator Installer"
        Width="1220" Height="720"
        MinWidth="1060" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="avares://UnityGameTranslatorInstaller/Assets/app.ico"
        Background="{DynamicResource SurfaceBase}">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header -->
    <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource SurfaceBar}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
      <!--
        Two rows on purpose. Six controls and a title do not fit on one line at the minimum
        window width, and squeezing them made the title collide with the language picker.
        Identity and tools on top, then the two things that decide what the list shows.
      -->
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <!--
            A Grid rather than a horizontal StackPanel, and that is what makes the trimming work:
            a StackPanel hands each child the width it asks for, so a TextBlock inside one never
            has a reason to shorten itself and pushes into whatever sits next to it instead. The
            starred column gives the text a width to fit into.

            The subtitle needs it as much as the title: it counts games, and both numbers grow.
          -->
          <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,0,16,0">
            <Image Grid.Column="0"
                   Source="avares://UnityGameTranslatorInstaller/Assets/icon-128.png"
                   Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Your Unity games" FontSize="18" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextPrimary}" />
              <TextBlock x:Name="SubtitleText" FontSize="12"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding #SubtitleText.Text}"
                         Text="Scanning..." Foreground="{DynamicResource TextMuted}" />
            </StackPanel>
          </Grid>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center">
            <Button x:Name="AddFolderButton" Content="Add a folder..." />
            <Button x:Name="FoldersButton" Content="My folders" />
            <Button x:Name="RescanButton" Content="Rescan" />
            <Button x:Name="SettingsButton" Content="Mod defaults" />
            <Button x:Name="ToolSettingsButton" Content="Settings" />
            <Button x:Name="AboutButton" Content="About" />
            <ContentControl x:Name="AccountSlot" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Play in" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource TextMuted}" />
          <ComboBox x:Name="LanguageBox" Width="170" />
          <TextBox x:Name="SearchBox" Width="240" Watermark="Search your games" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Body: games on the left, the selected game on the right -->
    <Grid Grid.Row="1" ColumnDefinitions="370,*">

      <Grid Grid.Column="0" RowDefinitions="Auto,*">
        <!--
          A WrapPanel, not a horizontal strip: five filters do not fit across 370px, and a strip
          clipped them instead of showing them. Wrapping costs a line and hides nothing.
        -->
        <WrapPanel Grid.Row="0" x:Name="FilterBar" Margin="10,10,10,2" />

        <ListBox Grid.Row="1" x:Name="GameList" Classes="cards"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
      </Grid>

      <ScrollViewer Grid.Column="1">
        <StackPanel x:Name="DetailPanel" Margin="20,16,24,24" Spacing="14">
          <TextBlock Text="Select a game on the left." Foreground="{DynamicResource TextMuted}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Padding="16,8" Background="{DynamicResource SurfaceBar}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                   FontSize="12" Text="Ready." TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextSecondary}" />
        <ProgressBar x:Name="BusyBar" Grid.Column="1" Width="160" Height="4"
                     Foreground="{DynamicResource Accent}"
                     IsIndeterminate="True" IsVisible="False" />
      </Grid>
    </Border>
  </Grid>
</Window>
