<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      A library, not a program of its own. The tool ships as ONE executable with two faces: given
      a known command it runs this front-end, given nothing it opens the window.

      Two binaries was the obvious shape and the wrong one. Everything downstream doubles: two
      files in the archive, two to replace when the tool updates itself (with a moment where one
      is new and the other old), two to sign the day we can afford it, two names to teach.

      What it costs is paid on Windows, where the subsystem is a property of the file: the file
      declares itself a window program so that opening the tool never puts a console on screen, and
      a window program does not hold a PowerShell prompt. A one-line batch file in the archive
      (ugt-manager.cmd, written by prepare-release.ps1) gives the command line back its ordinary
      behaviour — redirection, pipelines and exit codes — without adding a second program.
    -->
    <OutputType>Library</OutputType>
    <RootNamespace>UnityGameTranslator.Manager.Cli</RootNamespace>
    <AssemblyName>UnityGameTranslator.Manager.Cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnityGameTranslator.Manager.Core\UnityGameTranslator.Manager.Core.csproj" />
  </ItemGroup>

</Project>
