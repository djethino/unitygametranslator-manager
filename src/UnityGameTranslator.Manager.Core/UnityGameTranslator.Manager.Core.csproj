<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable and ImplicitUsings come from Directory.Build.props so every
       project in the solution moves together. -->
  <PropertyGroup>
    <RootNamespace>UnityGameTranslator.Manager.Core</RootNamespace>
    <AssemblyName>UnityGameTranslator.Manager.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The catalog ships inside the binary so the tool still works offline, or behind a
         network that blocks GitHub. It is the last-resort source, never the first. -->
    <EmbeddedResource Include="..\..\catalogs\loaders.json"
                      LogicalName="UnityGameTranslator.Manager.Core.Resources.loaders.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Registry access for Steam and GOG discovery. Windows-only at runtime; the calls sit
         behind SupportedOSPlatform so a Linux build never reaches them. -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rules this tool shares with the mod, held in one place rather than in two copies
         that drift. It targets netstandard2.0 because the mod runs on Unity; net8.0 consumes
         that without trouble, and the other direction would not work at all. -->
    <ProjectReference Include="..\..\common\src\UnityGameTranslator.Common\UnityGameTranslator.Common.csproj" />
  </ItemGroup>

</Project>
