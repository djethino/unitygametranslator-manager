# Build outputs
bin/
obj/

# IDE
.vs/
.vscode/
.idea/
*.user
*.suo
Properties/launchSettings.json

# Agent / local tooling config (same rule as the mod and the website)
.claude/

# OS files
.DS_Store
Desktop.ini
Thumbs.db

# Logs
*.log

# NuGet
packages/
*.nupkg

# Releases (generated by prepare-release.ps1)
releases/
publish/

# --- Specific to this project ---

# Diagnostic reports contain local paths and machine details: never commit one.
# Root-anchored on purpose: an unanchored "diagnostics/" also matched the source folder
# src/...Core/Diagnostics/ and silently excluded Sanitize.cs from the repository.
/diagnostics/
*.diag.txt
*.diag.json

# Install receipts are written next to a game, but tests may drop copies here.
*.ugt-receipt.json

# Local catalog overrides used to test a loader layout before publishing it.
catalog/*.local.json

